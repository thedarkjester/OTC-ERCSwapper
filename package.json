{
  "scripts": {
    "build": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:reportgas": "REPORT_GAS=true npx hardhat test",
    "coverage": "npx hardhat coverage",
    "solhint": "npx solhint 'contracts/**/*.sol'",
    "fmt:js:check": "prettier -c '**/*.{js,ts}'",
    "fmt:js": "prettier -w '**/*.{js,ts}'",
    "lint:js:check": "npx eslint '**/*.{js,ts}'",
    "lint:js": "npx eslint --fix '**/*.{js,ts}'",
    "fmt:sol:check": "prettier -c --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "fmt:sol": "npx prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'"
  },
  "name": "hardhat-project",
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "1.2.1",
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "hardhat": "2.28.6",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "2.3.1",
    "solhint": "6.2.1",
    "solhint-community": "4.0.1",
    "solhint-plugin-prettier": "0.1.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "overrides": {
    "ajv": "8.20.0",
    "axios": "1.17.0",
    "bn.js": "5.2.3",
    "brace-expansion": "2.1.1",
    "cookie": "0.7.2",
    "diff": "8.0.4",
    "elliptic": "6.6.1",
    "flatted": "3.4.2",
    "immutable": "5.1.6",
    "js-yaml": "4.2.0",
    "lodash": "4.18.1",
    "minimatch": "9.0.9",
    "picomatch": "4.0.4",
    "serialize-javascript": "7.0.5",
    "solhint-plugin-prettier": {
      "prettier-plugin-solidity": "$prettier-plugin-solidity"
    },
    "tmp": "0.2.7",
    "undici": "6.26.0",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  }
}
